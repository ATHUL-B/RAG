# Copy to .env (gitignored) and fill in. Never commit .env.
# Loaded by scripts/evaluate_generation.py; variables already set in the shell win.

# Claude via the Anthropic API (ADR 0005). Create a key at https://platform.claude.com
ANTHROPIC_API_KEY=

# An OpenAI-compatible LLM gateway (e.g. Bifrost, LiteLLM) for configs/generation-gateway.yaml.
# Base URL ending in /v1, and the key. Set the key's header in the config (gateway_key_header).
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=
